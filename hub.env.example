# ============================================
# reli_hub – Hub-Werte der edufeed-Umgebungsvariablen (Comenius-Institut/hub)
# ============================================
# Vorlage für die .env auf dem Server (liegt neben docker-compose.yml, außerhalb von git).
# Alle Schlüssel sind in .env.example (Steffens Vorlage) erklärt; hier stehen nur die Werte,
# die der Hub anders setzt. Nicht genannte Schlüssel behalten ihre Standardwerte.
# Datei heißt bewusst nicht .env.*, damit die Upstream-.gitignore unberührt bleibt.

# Öffentliche Adresse: ohne ORIGIN lehnt SvelteKit hinter dem Apache-Proxy jeden POST mit 403 ab.
ORIGIN=https://hub.rpi-virtuell.net
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Marke
APP_NAME=reli_hub
CLIENT_NAME=reli_hub
APP_LOGO=/steuerkonsole/logo.svg
APP_OG_DESCRIPTION=Dein Startplatz in die digitale Welt der Religionspädagogik
APP_GIT_REPO=https://git.rpi-virtuell.de/Comenius-Institut/hub
THEME_DEFAULT_LIGHT=rpi

# Relays (kommagetrennt)
FALLBACK_RELAYS=wss://relay.edufeed.org
CALENDAR_RELAYS=wss://relay-rpi.edufeed.org,wss://relay.edufeed.org
COMMUNIKEY_RELAYS=wss://relay-rpi.edufeed.org
AMB_RELAYS=wss://amb-relay.edufeed.org

# Kalender: hervorgehobene Quellen als 64-stellige Hex-Pubkeys (nicht npub), kommagetrennt.
# relilab (npub1fpcxa…), relilab-impuls (npub1lde03…), relilab-Termine-Bot (npub17mq54…)
CALENDAR_FEATURED_AUTHORS=48706e894e64be57a250d3cd1f4c8a0f69ca900937936f8bd11a1329cd3c97e3,fb72f8d4a788bffbaa77cd4ff5e9e0d063dd7e069bd057f33bba1e57ea5098b3,f6c14ab7add65d61cf9311a8685575c3f2de0ca540bc4ddf916f76f089f1aa43

# Beim Anmelden vorgeschlagene Community: relilab (npub)
SIGNUP_SUGGESTED_COMMUNITIES=npub1fpcxaz2wvjl90gjs60x37ny2pa5u4yqfx7fklz73rgfjnnfujl3sr2fxgk

# Anmeldung
NPUB_LOGIN_ENABLED=true
GOOGLE_LOGIN_ENABLED=false

# Impressum (Stand comenius.de, 26.10.2026)
IMPRINT_ENABLED=true
IMPRINT_ORGANIZATION=Comenius-Institut
IMPRINT_ADDRESS_STREET=Schreiberstraße 12
IMPRINT_ADDRESS_POSTAL_CODE=48149
IMPRINT_ADDRESS_CITY=Münster
IMPRINT_ADDRESS_COUNTRY=Deutschland
IMPRINT_CONTACT_EMAIL=info@comenius.de
IMPRINT_CONTACT_PHONE=0251 98101-0
IMPRINT_FUNDING=[{"image":"/BMBFSFJ.png","text":"FOERBICO, Förderkennzeichen 01PZ24007"}]
FOOTER_FUNDING_TEXT=reli_hub · ein Vorhaben von FOERBICO, gefördert vom BMBFSFJ (FKZ 01PZ24007)

# Secrets bleiben leer, bis sie gebraucht werden
GEOCODING_API_KEY=
EDUFEED_PUBLISHER_NSEC=
